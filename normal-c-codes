#include <stdio.h>

float average(int a[])
{
    int i, sum = 0;

    for (i = 0; i < 5; i++)
    {
        sum = sum + a[i];
    }

    return sum / 5.0;
}

int main()
{
    int a[5], i;

    printf("Enter 5 sensor readings:\n");

    for (i = 0; i < 5; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Average Sensor Reading = %.2f\n", average(a));

    return 0;
}


#include <stdio.h>

int main()
{
    int i, n;

    printf("Enter a number: ");
    scanf("%d", &n);

    for (i = 1; i <= 10; i++)
    {
        printf("%d x %d = %d\n", n, i, n * i);
    }

    return 0;
}


#include <stdio.h>

int main()
{
    int choice;

    printf("Select Robot Speed:\n");
    printf("1. Slow\n");
    printf("2. Medium\n");
    printf("3. Fast\n");

    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch (choice)
    {
        case 1:
            printf("Robot speed is SLOW.\n");
            break;

        case 2:
            printf("Robot speed is MEDIUM.\n");
            break;

        case 3:
            printf("Robot speed is FAST.\n");
            break;

        default:
            printf("Invalid choice.\n");
    }

    return 0;
}
